{
  "name": "updateNote",
  "method": "PATCH",
  "path": "/notes/:id",
  "operation": "db.update",
  "resource": "note.schema.iwc",
  "request": {
    "payload": {
      "title": { "type": "string", "minLength": 2, "maxLength": 120 },
      "body": { "type": "string", "maxLength": 2000 }
    }
  },
  "response": { "fields": { "id": "string", "title": "string", "body": "string" } },
  "security": { "auth": true }
}
