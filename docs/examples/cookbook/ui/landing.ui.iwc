{
  "name": "Landing",
  "route": "/",
  "layout": "main.layout.iwc",
  "title": "Welcome",
  "description": "A landing page built from IWC elements.",
  "sections": [
    {
      "type": "section",
      "className": "hero",
      "layout": { "direction": "column", "align": "center", "gap": "18px" },
      "animation": { "name": "fade-up", "trigger": "load" },
      "elements": [
        { "type": "badge", "content": "New: version 2" },
        { "type": "text", "variant": "title", "content": "Ship websites as data." },
        { "type": "text", "variant": "paragraph", "className": "lede", "content": "Describe pages, data and rules in JSON. IWC renders, validates and secures them." },
        {
          "type": "row", "layout": { "gap": "12px", "wrap": true, "justify": "center" },
          "elements": [
            { "type": "button", "label": "Browse products", "action": "navigate", "target": "/products" },
            { "type": "button", "label": "How it works", "variant": "secondary", "action": "scroll", "target": "features" }
          ]
        }
      ]
    },
    {
      "id": "features",
      "type": "section",
      "className": "band",
      "elements": [
        { "type": "text", "variant": "h2", "content": "Why teams use it" },
        {
          "type": "grid", "columns": 3, "responsiveColumns": { "tablet": 2, "mobile": 1 }, "gap": "24px",
          "elements": [
            { "type": "column", "className": "feature", "animation": { "name": "fade-up" }, "elements": [{ "type": "icon", "name": "check" }, { "type": "text", "variant": "h4", "content": "Validated" }, { "type": "text", "content": "Every file is checked against its schema and every reference resolved." }] },
            { "type": "column", "className": "feature", "animation": { "name": "fade-up", "delay": "100ms" }, "elements": [{ "type": "icon", "name": "settings" }, { "type": "text", "variant": "h4", "content": "Secure by default" }, { "type": "text", "content": "Escaping, CSRF, access rules and sessions are built in." }] },
            { "type": "column", "className": "feature", "animation": { "name": "fade-up", "delay": "200ms" }, "elements": [{ "type": "icon", "name": "chart" }, { "type": "text", "variant": "h4", "content": "Full stack" }, { "type": "text", "content": "Database, APIs, actions and jobs live next to the UI." }] }
          ]
        }
      ]
    },
    {
      "type": "section",
      "className": "band band-surface",
      "elements": [
        { "type": "text", "variant": "h2", "content": "Featured" },
        {
          "type": "grid", "columns": 3, "responsiveColumns": { "mobile": 1 }, "gap": "20px",
          "data": { "source": "DATABASE.products", "columns": ["name", "slug", "price", "image"], "filter": { "featured": true }, "limit": 3 },
          "item": { "type": "component", "use": "product-card.component.iwc", "props": { "product": { "bind": "item" } } }
        }
      ]
    },
    {
      "type": "section",
      "className": "band",
      "elements": [
        { "type": "review", "items": [
          { "rating": 5, "content": "We replaced three tools with forty JSON files.", "author": "Priya, CTO" },
          { "rating": 4, "content": "The error messages tell you the exact line to fix.", "author": "Tom, developer" }
        ] }
      ]
    },
    {
      "type": "section",
      "className": "band narrow",
      "elements": [
        { "type": "text", "variant": "h2", "content": "FAQ" },
        {
          "type": "accordion", "open": true,
          "items": [
            { "title": "Do I need to write JavaScript?", "content": "No. Behaviour is declared; the runtime provides it." },
            { "title": "Where is the data stored?", "content": "SQLite in development, SQLite or Postgres in production." }
          ]
        }
      ]
    }
  ]
}
